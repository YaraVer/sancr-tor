{
  "$schema": "https://opencode.ai/config.json",
  "model": "provider/paid-model-id",
  "small_model": "provider/cheap-model-id",
  "provider": {
    "provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Third-party API provider (example)",
      "options": {
        "baseURL": "https://YOUR_BASE_URL/v1",
        "apiKey": "{env:TOKENN_API_KEY}"
      },
      "models": {
        "paid-model-id": { "name": "Paid model" },
        "cheap-model-id": { "name": "Cheaper model" }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  }
}
